{
  "name": "@fabric-shading/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time fabric material and pattern generation for three.js WebGPU",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elx3020/fabric-shading.git",
    "directory": "packages/core"
  },
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "tsl",
    "fabric",
    "cloth",
    "shader"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./material": {
      "source": "./src/material/index.ts",
      "types": "./dist/material/index.d.ts",
      "default": "./dist/material/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "three": ">=0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "three": "0.187.0"
  }
}
