{
  "name": "fabric-shading",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fabric-shading/editor dev",
    "dev:phone": "pnpm --filter @fabric-shading/editor dev:phone",
    "demo": "pnpm --filter @fabric-shading/example-plane dev",
    "demo:phone": "pnpm --filter @fabric-shading/example-plane dev:phone",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
